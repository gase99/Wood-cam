# کپی کنید به .env و مقادیر را پر کنید:  cp .env.example .env

# توکن ربات تلگرام — از @BotFather بگیرید (اجباری)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# کلید API مدل هوش مصنوعی (اختیاری)
# بدون این کلید، ربات در «حالت نمایشی» با داده‌ی نمونه کار می‌کند
#
# ── Gemini (توصیه‌شده) ── کلید را از aistudio.google.com/apikey بگیرید:
# AI_API_KEY=AIza...
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.8-flash
#
# ── OpenAI / هر API سازگار ──
AI_API_KEY=sk-...
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# سکرت وب‌هوک (اختیاری) — برای اعتبارسنجی درخواست‌های تلگرام
WEBHOOK_SECRET=change-me
